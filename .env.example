# Throwaway testnet wallet ONLY. Never put a key that holds real funds here.
# Generate one with: npm run wallet:new
EVM_PRIVATE_KEY=

# Telegraph testnet node
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Spend guard (USD). A single memo costs roughly $0.10-$0.20 on testnet.
VETTED_MAX_PER_CALL_USD=0.05
VETTED_MAX_PER_MEMO_USD=0.40
VETTED_MAX_PER_DAY_USD=5

# Set to 1 to run with recorded fixtures instead of real paid calls (output is labelled SIMULATED)
VETTED_SIMULATE=0

PORT=8787

# Telegram bot (optional). Create one with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=
# Public URL of this deployment (enables "full memo" links and webhook mode for the bot)
PUBLIC_URL=
# Set to "polling" to force polling even when PUBLIC_URL is set
TELEGRAM_MODE=
